{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "PORT",
    "DATABASE_URL",
    "AUTH_DEV_BYPASS",
    "AI_STUB_MODE",
    "AVP_POLICY_STORE_ID",
    "OIDC_INTERNAL_ISSUER",
    "OIDC_SUPPLIER_ISSUER",
    "NEXT_PUBLIC_API_URL",
    "IF_API_URL",
    "IF_API_TOKEN",
    "AWS_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "cdk.out/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
