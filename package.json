{
  "name": "intuitive-fusion",
  "private": true,
  "description": "Intuitive Fusion — conversational, AI-first procurement & contract lifecycle management platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @if/api prisma:generate",
    "db:migrate": "pnpm --filter @if/api prisma:migrate",
    "infra:synth": "pnpm --filter @if/infra synth",
    "requirements:export": "python3 scripts/export_requirements.py"
  },
  "devDependencies": {
    "turbo": "^2.11.8",
    "typescript": "~5.9.3",
    "@types/node": "^22.20.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines"
    ]
  }
}
