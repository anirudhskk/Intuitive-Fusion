{
  "name": "@if/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK infrastructure as code (NFR-M01) — BRS §5 reference architecture",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "synth": "tsc -p tsconfig.json && cdk synth --quiet",
    "cdk:deploy": "tsc -p tsconfig.json && cdk deploy",
    "diff": "tsc -p tsconfig.json && cdk diff",
