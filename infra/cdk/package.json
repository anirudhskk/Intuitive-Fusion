    "lint": "echo \"TODO: cdk-nag (AwsSolutions, NIST/ISM packs)\""
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "aws-cdk": "^2.1100.0",
    "typescript": "~5.9.3"
  }
}
